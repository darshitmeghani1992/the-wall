{
  "expo": {
    "name": "The Wall",
    "slug": "the-wall",
    "owner": "darsh9899",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "thewall",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "cover",
      "backgroundColor": "#fbf9f4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thewall.app",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.thewall.app",
      "adaptiveIcon": {
        "backgroundColor": "#f3e300",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "The Wall needs access to your photos so you can share memories.",
          "cameraPermission": "The Wall needs your camera so you can capture a photo or video Mark."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "The Wall needs your microphone so you can record a voice Mark."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "eas": {
        "projectId": "6abd7556-d524-40cd-b923-2819a689851e"
      }
    },
    "icon": "./assets/icon.png"
  }
}
