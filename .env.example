# Supabase — reuse the existing project (same one the Next.js app uses).
# Project Settings → API. These are exposed to the client (safe: anon key only).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OAuth redirect (native deep link handled by expo-auth-session).
# Configure the same value in Supabase → Authentication → URL Configuration.
EXPO_PUBLIC_AUTH_REDIRECT=thewall://auth/callback
